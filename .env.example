# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Claude ---
# claude-code: uses your Claude subscription through the Claude Code CLI (no key, no credits)
# api:         uses ANTHROPIC_API_KEY and prepaid API credits
COACH_BACKEND=claude-code
# Only for COACH_BACKEND=claude-code if Claude Code isn't found automatically
CLAUDE_CODE_PATH=
# Only for COACH_BACKEND=api (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5
# Optional cheaper/faster model for `coach ask` / `coach chat`
COACH_CHAT_MODEL=

# --- Garmin ---
# Folder holding the OAuth tokens written by `coach login` (outside the repo)
GARMIN_TOKEN_DIR=~/.garminconnect
# First day the initial backfill pulls
SYNC_START_DATE=2025-01-01
# Re-fetch this many recent days on every sync (Garmin finalises sleep/HRV late)
SYNC_REFRESH_DAYS=3
# Seconds to pause between Garmin calls (rate-limit protection)
SYNC_THROTTLE_S=0.4
# Also download original FIT files for each activity (large)
SYNC_FIT=false

# --- Paths (relative to the project folder) ---
COACH_DB=data/coach.db
REPORTS_DIR=reports/out

# --- Delivery (all OFF by default; nothing is sent anywhere unless true) ---
DELIVERY_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

DELIVERY_NOTION=false
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
